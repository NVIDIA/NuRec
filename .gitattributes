# Set default behaviour to automatically normalize line endings.
* text=auto
# Force bash scripts to always use LF line endings so that if a repo is accessed
# in Unix via a file share from Windows, the scripts will work.
*.sh text eol=lf
# Unified diffs encode blank context lines as one leading space.
*.patch whitespace=-blank-at-eol

# Generated by the third-party notices tooling; the formatter must not rewrite it.
/THIRD_PARTY_NOTICES.md linguist-generated=true rules-lint-ignored=true
/third_party_licenses/** linguist-generated=true rules-lint-ignored=true
