# PAI -> NCore V4 converter. The nvidia-ncore wheel packages only ncore/, so build the tools/
# sources from the repo at the same revision as the wheel pin. Replace with a plain wheel
# dependency once the converter ships in nvidia-ncore. Patched locally to decode camera video in
# presentation order (deps/ncore_pai_converter).
http_archive(
    name = "ncore_pai_converter",
    build_file_content = """
load("@rules_python//python:defs.bzl", "py_library")
load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")

py_library(
    name = "pai_converter",
    srcs = glob([
        "tools/debug.py",
        "tools/data_converter/cli.py",
        "tools/data_converter/pai/*.py",
        "tools/data_converter/pai/pai_remote/*.py",
    ]),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        pip_requirement("click"),
        # tools/data_converter/cli.py imports tools.debug at module scope, which needs debugpy.
        pip_requirement("debugpy"),
        pip_requirement("DracoPy"),
        pip_requirement("imageio"),
        pip_requirement("numpy"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("pandas"),
        pip_requirement("pillow"),
        pip_requirement("pyarrow"),
        pip_requirement("PyNvVideoCodec"),
        pip_requirement("remotezip"),
        pip_requirement("requests"),
        pip_requirement("rich"),
        pip_requirement("scipy"),
        pip_requirement("tqdm"),
        pip_requirement("universal-pathlib"),
    ],
)
""",
    patch_args = ["-p1"],
    # Drop ncore's nested BUILD files; they would make tools/ sub-packages the glob cannot reach.
    patch_cmds = ["find tools -name 'BUILD.bazel' -delete"],
    patches = ["//deps/ncore_pai_converter:simpledecoder_order.patch"],
    sha256 = "b70f00d77ed2088ea6be50d3eb35ad4f66e40c2476260daebaabd8000418dec8",
    strip_prefix = "ncore-cbd8c16f3487186e8848e707eece0045ece3a058",
    urls = ["https://github.com/NVIDIA/ncore/archive/cbd8c16f3487186e8848e707eece0045ece3a058.tar.gz"],
)

