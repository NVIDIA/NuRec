pip.parse(
    timeout = 3000,
    enable_implicit_namespace_pkgs = True,
    # Stop the tensorrt-cu12 sdist's setup.py "pip-inside-pip hack" from running a
    # nested, unscoped `pip install` that silently redirects to pypi.nvidia.com and
    # pollutes the hermetic Python toolchain.
    # With this set, setup.py declares tensorrt-cu12-libs/-bindings as normal
    # install_requires instead.
    environment = {"NVIDIA_TENSORRT_DISABLE_INTERNAL_PIP": "1"},
    extra_hub_aliases = EXTRA_HUB_ALIASES,
    hub_name = "nurec_pip_deps",
    python_version = "3.13",
    requirements_by_platform = {
        "//deps/python:requirements_3_13_x86_64.txt": "linux_x86_64",
    },
    whl_modifications = WHL_MODIFICATIONS,
)
