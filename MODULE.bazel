python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.13",
)

# rules_python 2.3.2's bundled python-build-standalone catalog doesn't include the
# 3.13.15 "20260807" release (it tops out at 3.13.13), so we register its download
# URL + sha256 explicitly here
# (the standard single_version_override mechanism for a build not in the catalog). The
# 3.11.14 toolchain was in-catalog, which is why it needed no urls override. The urls
# entry is the release-relative path resolved against the default base_url.
python.single_version_override(
    python_version = "3.13.15",
    sha256 = {
        "aarch64-unknown-linux-gnu": "68159637492dcf3501c0967b69e07665c3dda070fb42231737055f72963f66fc",
        "x86_64-unknown-linux-gnu": "7253808c3413d9ebd03e76b3853c895b9287f12e0750a30fce1cbf430e516113",
    },
    strip_prefix = "python",
    urls = ["20260807/cpython-{python_version}+20260807-{platform}-{build}.tar.gz"],
)
use_repo(python, "python_3_13", "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Pin which hub the unified @pypi resolves packages from (gsplat consumes
# torch through @pypi); without it the alphabetically-first hub wins.
pip.default(default_hub = "nurec_pip_deps")
pip.whl_mods(
    additive_build_content = """
# Make torch headers / libraries available to C++ rules

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

cc_library(
    # Internal target, do not use directly. Use //deps/torch:torch_headers instead,
    # which adds the CUDA header deps that torch headers transitively require
    # but cannot be declared here because @cuda is not visible inside pip-generated repos.
    name = 'torch_header_no_cuda_deps',
    includes = [
        'site-packages/torch/include',
        'site-packages/torch/include/torch/csrc/api/include',
    ],
    hdrs = glob(['site-packages/torch/include/**/*.h']) + glob(['site-packages/torch/include/**/*.hpp']) + glob(['site-packages/torch/include/**/*.cuh']),
)

# ------------------------

cc_import(
    name = "libtorch_python",
    shared_library = "site-packages/torch/lib/libtorch_python.so",
)

# ------------------------

cc_import(
    name = "libc10",
    shared_library = "site-packages/torch/lib/libc10.so",
)

# ------------------------

cc_import(
    name = "libc10_cuda",
    shared_library = "site-packages/torch/lib/libc10_cuda.so",
)

# ------------------------

cc_import(
    name = "libtorch",
    shared_library = "site-packages/torch/lib/libtorch.so",
)

# ------------------------

cc_import(
    name = "libtorch_cpu",
    shared_library = "site-packages/torch/lib/libtorch_cpu.so",
)

# ------------------------

cc_import(
    name = "libtorch_cuda",
    shared_library = "site-packages/torch/lib/libtorch_cuda.so",
)
""",
    hub_name = "whl_mods_hub",
    whl_name = "torch",
)
pip.whl_mods(
    additive_build_content = """
# Make tcnn headers / libraries available to C++ rules

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

cc_library(
    name = 'tinycudann_headers',
    includes = [
        'site-packages/tinycudann/rtc/include'
    ],
    hdrs = glob(['site-packages/tinycudann/rtc/include/**/*']),
)

# ------------------------
""" +
                             "\n".join(["""
cc_import(
    name = "lib_tinycudann_{0}_{1}",
    shared_library = "site-packages/tinycudann_bindings/_{0}_C.cpython-313-{1}-linux-gnu.so",
)""".format(GPU_ARCH, CPU_ARCH) for GPU_ARCH in [
                                 70,
                                 75,
                                 80,
                                 86,
                                 89,
                                 90,
                                 100,
                                 120,
                             ] for CPU_ARCH in [
                                 "x86_64",
                                 "aarch64",
                             ]]),
    hub_name = "whl_mods_hub",
    whl_name = "tinycudann",
)
pip.whl_mods(
    additive_build_content = """
# Make numpy headers available to C++ rules

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = 'numpy_headers',
    includes = [
        'site-packages/numpy/core/include',
    ],
    hdrs = glob(['site-packages/numpy/core/include/**/*.h']),
)
""",
    hub_name = "whl_mods_hub",
    whl_name = "numpy",
)

# Patch triton to enhance libcuda.so detection and apply an arch cap for SM
# versions not supported by CUDA 12.8.
[
    pip.override(
        file = "triton-3.6.0-cp313-cp313-manylinux_2_27_%s.manylinux_2_28_%s.whl" % (CPU_ARCH, CPU_ARCH),
        patch_strip = 1,
        patches = [
            "deps/triton/triton.patch",
        ],
    )
    for CPU_ARCH in [
        "x86_64",
        "aarch64",
    ]
]

# Patch slangtorch to prefer the Bazel-pinned slangc from runfiles (so runtime
# JIT matches the build-time slang), falling back to the bundled binary.
pip.override(
    file = "slangtorch-1.3.18-py3-none-any.whl",
    patch_strip = 1,
    patches = [
        "deps/slangtorch/slangtorch.patch",
    ],
)

# Patch mmengine to add force=True to Adafactor registration to avoid duplicate
# registration conflict with transformers
pip.override(
    file = "mmengine-0.10.5-py3-none-any.whl",
    patch_strip = 1,
    patches = [
        "deps/mmengine/mmengine.patch",
    ],
)

# Patch zarr 2.18.2 for compatibility with numcodecs>=0.16, which renamed two
# functions that zarr imports (cbuffer_sizes and cbuffer_metainfo) to private names.
pip.override(
    file = "zarr-2.18.2-py3-none-any.whl",
    patch_strip = 1,
    patches = [
        "deps/zarr/zarr.patch",
    ],
)
use_repo(pip, "whl_mods_hub")

