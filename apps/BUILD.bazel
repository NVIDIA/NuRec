load("@aspect_rules_py//py:defs.bzl", "py_image_layer")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")
load("//bazel/rules_oci:default_layer_groups.bzl", "default_layer_groups")

# Makes 'apps' a regular package (rather than an implicit namespace package) in the
# runfiles of nested targets. Mirrors '//nurec/libs:pylib'. Targets under //apps/... that need
# 'apps/__init__.py' present at runtime -- notably pytest_test targets, since pytest
# derives a test module's dotted name by walking up while '__init__.py' files exist --
# should depend on this.
py_library(
    name = "pylib",
    srcs = ["__init__.py"],
    visibility = ["//apps:__subpackages__"],
)

# by default, install all tools
# debugpy / pydantic are included for generating the runtime version string
NUREC_TOOLS_DEPS = [
    pip_requirement("click"),
    pip_requirement("click-default-group"),
    "//nurec/config:pylib_version",
    "//nurec:pylib",
    "//nurec/utils:pylib_ffmpeg_config",
    "@ncore_pai_converter//:pai_converter",
    "//workflows/av_benchmark:row_lib",
    "//workflows/av_benchmark:reference_map_lib",
] + select({
    "//bazel/conditions:all_tools": [
        "//apps/av/aux_gen:pylib",
    ],
    "//bazel/conditions:ncore_aux_data": [
        "//apps/av/aux_gen:pylib",
    ],
    "//conditions:default": [],
}) + select({
    "//bazel/conditions:all_tools": [
        "//apps/av/avmask_annotator:pylib",
    ],
    "//bazel/conditions:mask_annotator": [
        "//apps/av/avmask_annotator:pylib",
    ],
    "//conditions:default": [],
})

NUREC_TOOLS_DATA = [
    "//:notices_file",
]

################################################################
# Common image rules
################################################################

# Layer for HOME directory writable by all users
# (ex. to receive default cache folder for various Python dependencies, though
# this won't be persisted in our typical container invocations).
pkg_tar(
    name = "home_dir_tar",
    compressor = "@pigz//:pigz",
    empty_dirs = ["/home"],
    extension = "tar.gz",
    mode = "0777",
    tags = [
        "manual",
    ],
)

################################################################
# Normal container rules
################################################################

# OCI image for 'nurec_tools'
py_image_layer(
    name = "nurec_tools_image_layer",
    binary = "nurec_tools",
    compressor = "@pigz//:pigz",
    compressor_args = "-n",
    layer_groups = default_layer_groups(),
    root = "/app/",
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

# Preserve the executable path used by existing container consumers while the
# source target moves to repository-root //apps. The Python stub also requires
# its runfiles tree next to argv[0].
pkg_tar(
    name = "nurec_tools_compatibility_paths",
    compressor = "@pigz//:pigz",
    extension = "tar.gz",
    package_dir = "/app",
    symlinks = {
        "nurec/apps/nurec_tools": "../../apps/nurec_tools",
        "nurec/apps/nurec_tools.runfiles": "../../apps/nurec_tools.runfiles",
    },
    tags = ["manual"],
)

oci_image(
    name = "nurec_tools_image_oci",
    base = "@nurec_run_image_oci",
    entrypoint = ["/app/apps/nurec_tools"],
    env = {
        "HOME": "/home",
        "TORCHINDUCTOR_CACHE_DIR": "/tmp/torchinductor",
        "USER": "nurec",
    },
    tags = [
        "manual",
        "no-remote-cache",
    ],
    tars = [
        "//bazel/cuda_compat:compat_tar",  # put first: rarely changes
        "//:image_licenses_tar",
        ":nurec_tools_image_layer",
        ":nurec_tools_compatibility_paths",
        ":home_dir_tar",
        "//bazel/version:version_file_yaml_tar",
    ],
)

# Build the image and load it into a local runtime:
# $ bazel run //apps:load_nurec_tools_image_oci
# $ docker run -it --rm --gpus all ghcr.io/nvidia/nurec/nurec_tools:latest
#
# Note: this target assigns the ':latest' tag for the local machine's native architecture.
# This differs from registry contents pushed by CI, for which ':latest' is always the
# x86_64 image.
oci_load(
    name = "load_nurec_tools_image_oci",
    image = ":nurec_tools_image_oci",
    repo_tags = ["ghcr.io/nvidia/nurec/nurec_tools:latest"],
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

# Push the image to the registry:
# $ bazel run //apps:push_nurec_tools_image_oci [-- --tag ${TAG}]
# Note: Don't push the 'latest' tag from local builds, we reserve this to images generated by post-merge pipelines in CI.
#       A custom tag can be specific on the above command if needed.
oci_push(
    name = "push_nurec_tools_image_oci",
    image = ":nurec_tools_image_oci",
    repository = "ghcr.io/nvidia/nurec/nurec_tools",  # this can be overriden by providing --repository
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

################################################################
# PyBinary rules
################################################################

# The generated Click group, importable as 'apps.entrypoint'. Composition roots that need
# to register extra subcommands depend on this library instead of forking 'gen_entrypoint'.
py_library(
    name = "nurec_tools_cli",
    srcs = [":entrypoint.py"],
    data = NUREC_TOOLS_DATA,
    visibility = [],
    deps = NUREC_TOOLS_DEPS + [":pylib"],
)

py_binary(
    name = "nurec_tools",
    srcs = [
        "__init__.py",
        ":entrypoint.py",
    ],
    data = NUREC_TOOLS_DATA,
    main = "entrypoint.py",
    visibility = [
        # Add visibility for the AV Benchmark workflow
        "//workflows/av_benchmark:__pkg__",
    ],
    deps = NUREC_TOOLS_DEPS,
)

pytest_test(
    name = "pai_convert_decode_test",
    srcs = ["pai_convert_decode_test.py"],
    data = ["testdata/hevc_bframes_levels.mp4"],
    tags = ["gpu"],
    deps = [
        "@ncore_pai_converter//:pai_converter",
        "@rules_python//python/runfiles",
    ],
)

pytest_test(
    name = "pai_convert_test",
    srcs = ["pai_convert_test.py"],
    data = [":entrypoint.py"],
    deps = [
        "@ncore_pai_converter//:pai_converter",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "gen_entrypoint_tool",
    srcs = ["gen_entrypoint.py"],
    main = "gen_entrypoint.py",
    deps = [
        pip_requirement("pyyaml"),
        pip_requirement("jinja2"),
    ],
)

# Generate entrypoint.py based off desired tools
run_binary(
    name = "gen_entrypoint",
    srcs = [
        "templates/entrypoint.py.j2",
        "tools.yaml",
    ],
    outs = ["entrypoint.py"],
    args = [
        "--config",
        "$(location tools.yaml)",
        "--template=$(location templates/entrypoint.py.j2)",
        "--output=$(location entrypoint.py)",
        "--enabled-tools",
        "pai-convert",
        "pai-clip-dl",
        "benchmark-row",
        "inject-reference-map",
    ] + select({
        "//bazel/conditions:all_tools": [
            "ncore-aux-data",
            "mask-annotator",
        ],
        "//conditions:default": [],
    }) + select({
        "//bazel/conditions:ncore_aux_data": ["ncore-aux-data"],
        "//conditions:default": [],
    }) + select({
        "//bazel/conditions:mask_annotator": ["mask-annotator"],
        "//conditions:default": [],
    }),
    tool = ":gen_entrypoint_tool",
)
