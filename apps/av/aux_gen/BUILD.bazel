load("@mypy_integration//:mypy.bzl", "mypy_test")
load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")

# nurec:allow-direct-py-test - worker_spawn_test must run as an import-safe main so multiprocessing
# `spawn` does not recursively start the repository's pytest launcher.
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//bazel/pytest:defs.bzl", "pytest_test")

# ----------------------------------------------------------------------------------

# Mask2Former TensorRT engines, one http_file per engine (see MODULE.bazel). Grouped
# here so consumers reference a single target; each lands in runfiles at
# trt_engine_<key>/file/<engine> (searched by find_network_file_path in estimators.py).
filegroup(
    name = "mask2former_trt_engines",
    srcs = [
        "@trt_engine_5880_x86_64//file",
        "@trt_engine_a100_x86_64//file",
        "@trt_engine_a40_x86_64//file",
        "@trt_engine_a6000_x86_64//file",
        "@trt_engine_ampereplus_aarch64//file",
        "@trt_engine_ampereplus_x86_64//file",
        "@trt_engine_l40_aarch64//file",
        "@trt_engine_l40_x86_64//file",
        "@trt_engine_l4_x86_64//file",
    ],
    visibility = ["//visibility:public"],
)

################################################################
# Deps list
################################################################

NCORE_AUX_DATA_DEPS = [
    ":pylib_depth_estimator",
    pip_requirement("torch"),
    pip_requirement("nvidia-ncore"),
    pip_requirement("click"),
    pip_requirement("tqdm"),
    pip_requirement("numpy"),
    pip_requirement("zarr"),
    pip_requirement("torchvision"),
    pip_requirement("dataclasses_json"),
    pip_requirement("point-cloud-utils"),
    pip_requirement("universal-pathlib"),
    pip_requirement("s3fs"),
    pip_requirement("setuptools"),
    pip_requirement("pillow"),
    ":pylib_device_frame",
    ":pylib_segmentation_device_pipeline",
    ":pylib_estimators_aux",
    ":pylib_device_frame_service",
    ":pylib_shared_segmentation",
    ":pylib_utils_aux",
    "//nurec/ncore_backends:pylib",
    "//nurec/utils:pylib_cli",
    "//nurec/utils:pylib_ncore_types",
    "//nurec/utils:pylib_files",
    "//nurec/utils:pylib_ncore_utils",
    "//nurec/utils:pylib_types",
    "//nurec/utils/debug:pylib",
]

NCORE_AUX_DATA_DATA = [
    "//:notices_file",
]

################################################################
