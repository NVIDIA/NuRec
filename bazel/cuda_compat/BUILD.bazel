load("@rules_python//python:defs.bzl", "py_binary")
load("//bazel/pytest:defs.bzl", "pytest_test")
load(":defs.bzl", "cuda_compat_tar")

# Libraries shipped by the cuda-compat .deb, at their default location.
cuda_compat_tar(
    name = "compat_tar",
    deb = "@cuda_compat//:deb",
    prefix = "usr/local/cuda/compat",
    tags = [
        "manual",
        "no-remote-cache",
    ],
    visibility = [
        "//:__pkg__",
        "//apps:__pkg__",
        "//nurec/instant_nurec:__pkg__",
    ],
)

pytest_test(
    name = "compat_tar_test",
    size = "small",
    srcs = ["compat_tar_test.py"],
    data = [":compat_tar"],
    mypy = False,
)

py_binary(
    name = "extract_deb_data",
    srcs = ["extract_deb_data.py"],
    main = "extract_deb_data.py",
    visibility = ["//visibility:private"],
)

pytest_test(
    name = "extract_deb_data_test",
    size = "small",
    srcs = [
        "extract_deb_data.py",
        "extract_deb_data_test.py",
    ],
)
