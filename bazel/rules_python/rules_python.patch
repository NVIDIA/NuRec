   runfiles_root="$1"
   interpreter_path="$2"
diff --git a/python/private/stage2_bootstrap_template.py b/python/private/stage2_bootstrap_template.py
index f445ad2..bc297cb 100644
--- a/python/private/stage2_bootstrap_template.py
+++ b/python/private/stage2_bootstrap_template.py
@@ -484,6 +484,116 @@ def _add_site_packages(site_packages):
     sys.path[first_global_offset:0] = added_dirs
 
 
+def _nurec_preinit_cuda_under_flock():
+    """NuRec patch: pre-create the CUDA primary context on aarch64 (DGX Spark).
+
+    GB10 has unified memory, so a primary context is backed by order-9 (2 MiB)
+    contiguous system pages. A parallel Bazel build's page-cache churn starves
+    those for seconds at a time (MemFree still in the gigabytes), and
+    cuDevicePrimaryCtxRetain fails with CUDA_ERROR_OUT_OF_MEMORY, which torch
+    reports as "CUDA error: out of memory" on the first CUDA call. So retain it
+    here, before any user code, retrying until the famine clears.
+
+    The flock (which also serializes context creation, a separate aarch64 race)
+    is held per attempt and dropped while backing off, otherwise every other
+    test process on the host queues behind the full budget. pycuda.autoinit
+    goes under the same lock as a second context-creation path. It has never
+    been seen to hit the famine, so it is not retried.
+    """
+    if os.uname().machine != "aarch64":
+        return
+    import ctypes
+    try:
+        cuda = ctypes.CDLL("libcuda.so.1")
+    except OSError:
+        return  # non-CUDA environment, nothing to do
+    import contextlib
+    import fcntl
+    import random
+    import time
+    import warnings
+
+    cuda_error_out_of_memory = 2
+    # Retry for as much as 60s to catch most famine situations.
+    budget_s = 60.0
+
+    # Per-user lock path: 0o600 mode + UID in the name avoid umask-induced
+    # downgrade to per-user serialization (mode 0o666 is &'d with umask, so
+    # the first process to create the file decides the perms for everyone)
+    # and dodge predictable-path symlink races from other local users.
+    lock_path = os.path.join(
+        os.environ.get("TMPDIR", "/tmp"), f".nurec-cuda-init.{os.getuid()}.lock"
+    )
+    try:
+        lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
+    except OSError as e:
+        warnings.warn_explicit(
+            f"cannot open CUDA init lock file {lock_path}: {e}; skipping CUDA preinit",
+            RuntimeWarning,
+            filename="rules_python",
+            lineno=0,
+        )
+        return
+
+    def _warn(msg):
+        warnings.warn_explicit(
+            msg, RuntimeWarning, filename="rules_python", lineno=0
+        )
+
+    @contextlib.contextmanager
+    def _locked():
+        fcntl.flock(lock_fd, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock_fd, fcntl.LOCK_UN)
+
+    try:
+        with _locked():
+            rc = cuda.cuInit(0)
+        if rc != 0:
+            _warn(f"cuInit(0) returned {rc}; skipping CUDA preinit")
+            return
+
+        # Holding the primary context for this process's lifetime makes torch's
+        # later cudaSetDevice / cudaStreamIsCapturing find it already created.
+        ctx = ctypes.c_void_p()
+        started = time.monotonic()
+        deadline = started + budget_s
+        attempts = 0
+        while True:
+            attempts += 1
+            with _locked():
+                rc = cuda.cuDevicePrimaryCtxRetain(ctypes.byref(ctx), 0)
+            if rc != cuda_error_out_of_memory or time.monotonic() >= deadline:
+                break
+            # Jittered so the waiters do not re-collide on the lock in lockstep.
+            time.sleep(random.uniform(0.2, 1.5))
+        if rc != 0:
+            # Reports the real attempt count and elapsed time: a non-OOM error
+            # breaks out on the first call, without exhausting the budget.
+            _warn(
+                f"cuDevicePrimaryCtxRetain returned {rc} after {attempts} "
+                f"attempt(s) in {time.monotonic() - started:.1f}s; this "
+                "process will likely fail on its first CUDA call"
+            )
+
+        # Cached once imported, so the later `import pycuda.autoinit` from
+        # mmseg.trt.trt_utils is a no-op.
+        with _locked():
+            try:
+                import pycuda.autoinit  # noqa: F401
+            except ImportError:
+                pass  # pycuda not installed in this binary
+            except Exception as e:
+                _warn(
+                    f"pycuda.autoinit failed under flock: {e}; "
+                    "TRT context creation may surface failures"
+                )
+    finally:
+        os.close(lock_fd)
+
+
