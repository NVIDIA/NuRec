diff --git a/python/private/stage1_bootstrap_template.sh b/python/private/stage1_bootstrap_template.sh
index 4374ff9..1a05052 100644
--- a/python/private/stage1_bootstrap_template.sh
+++ b/python/private/stage1_bootstrap_template.sh
@@ -133,6 +133,123 @@ if [[ -n "$RULES_PYTHON_TESTING_TELL_RUNFILES_ROOT" ]]; then
   export RULES_PYTHON_TESTING_RUNFILES_ROOT="$RUNFILES_DIR"
 fi
 
+# NuRec patch: on aarch64, cap the reported/used CUDA arch to a forward-
+# compatible one on hardware CUDA 12.8 nvrtc/ptxas reject: SM 12.1 (DGX
+# Spark / GB10) -> 12.0 and SM 10.3 (GB300) -> 10.0. Other aarch64 GPUs
+# (e.g. GH200 SM 9.0) are left untouched.
+if [[ "$(uname -m)" == "aarch64" ]]; then
+  _compute_cap=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -n1)
+  if [[ "$_compute_cap" == "12.1" ]]; then
+    # LD_PRELOAD the sm_cap shim: rewrites sm_121 -> sm_120 in nvrtcCompileProgram
+    # options (via dlsym) and clamps the reported compute capability 12.1 -> 12.0.
+    _sm_cap="$RUNFILES_DIR/_main/deps/sm_cap/libsm_cap.so"
+    if [[ -f "$_sm_cap" ]]; then
+      export LD_PRELOAD="${_sm_cap}${LD_PRELOAD:+:$LD_PRELOAD}"
+    fi
+    # Tell torch's JIT path to compile for SM 12.0.
+    export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-12.0+PTX}"
+    # Tell triton's NVIDIA backend to compile for SM 12.0. TRITON_OVERRIDE_ARCH
+    # is triton's public knob (feeds parse_options). TRITON_OVERRIDE_SM_ARCH is
+    # added by deps/triton/triton.patch and fixes the paths the public knob
+    # doesn't reach (sm_arch_from_capability suffix and the `.target sm_{int}`
+    # regex substitution in make_ptx).
+    export TRITON_OVERRIDE_ARCH="${TRITON_OVERRIDE_ARCH:-sm120}"
+    export TRITON_OVERRIDE_SM_ARCH="${TRITON_OVERRIDE_SM_ARCH:-sm_120}"
+    # Autotuned Triton GEMMs use arch-specific instructions the generic target lacks.
+    export TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS="${TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS:-ATEN}"
+  elif [[ "$_compute_cap" == "10.3" ]]; then
+    # GB300 (Blackwell Ultra) reports SM 10.3: same as the SM 12.1 block above,
+    # but cap to the forward-compatible SM 10.0 (+PTX) and rewrite sm_103 -> sm_100.
+    _sm_cap="$RUNFILES_DIR/_main/deps/sm_cap/libsm_cap.so"
+    if [[ -f "$_sm_cap" ]]; then
+      export LD_PRELOAD="${_sm_cap}${LD_PRELOAD:+:$LD_PRELOAD}"
+    fi
+    export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-10.0+PTX}"
+    export TRITON_OVERRIDE_ARCH="${TRITON_OVERRIDE_ARCH:-sm100}"
+    export TRITON_OVERRIDE_SM_ARCH="${TRITON_OVERRIDE_SM_ARCH:-sm_100}"
+    export TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS="${TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS:-ATEN}"
+  fi
+  unset _compute_cap _sm_cap
+fi
+
+# NuRec patch: point the runtime JIT (slangtorch, torch cpp_extension,
+# Transformer Engine) at the CUDA toolkit subset staged in runfiles, and put
+# its libraries on the loader path: prebuilt extensions such as tinycudann
+# carry no usable RPATH, so libnvrtc only resolves through the global search
+# path. Exported whether or not the target depends on the toolkit, so that one
+# missing that dependency fails the same way everywhere instead of picking up
+# whatever CUDA the machine happens to have.
+_cuda_home="$RUNFILES_DIR/_main/bazel/cuda_toolkit/runtime"
+export CUDA_HOME="$_cuda_home"
+export PATH="$_cuda_home/bin:$PATH"
+export LD_LIBRARY_PATH="$_cuda_home/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+unset _cuda_home
+
+# NuRec patch: the runtime JIT (slangtorch + torch cpp_extension) drives nvcc,
+# which (CUDA 12.8) rejects host gcc > 14. Only replace the host compiler when
+# the default one is actually unusable (a gcc newer than 14, or none at all):
+# forcing $CC/$CXX otherwise changes the compiler torch records for its
+# prebuilt/cached extensions, so they get rebuilt from scratch on every run --
+# a multi-minute JIT recompile that times tests out. A user-provided $CC/$CXX
+# is always honored, and a one-sided override is mirrored so they never diverge.
+if [[ -n "${CC:-}" || -n "${CXX:-}" ]]; then
+  export CC="${CC:-$CXX}"
+  export CXX="${CXX:-$CC}"
+else
+  # Probe the default host C++ compiler torch/nvcc use when $CXX is unset and
+  # expand __GNUC__ to read its gcc major version (clang reports 4, so it is
+  # left untouched). Only a gcc > 14 -- or no compiler at all -- is replaced;
+  # overriding an already-usable default would force a full extension recompile.
+  _def_cxx=
+  for _c in c++ g++; do
+    if command -v "$_c" >/dev/null 2>&1; then _def_cxx="$_c"; break; fi
+  done
+  _need_override=
+  if [[ -z "$_def_cxx" ]]; then
+    _need_override=1
+  else
+    _defmaj=$(printf '__GNUC__\n' | "$_def_cxx" -E -P -x c++ - 2>/dev/null | tr -dc '0-9')
+    if [[ -n "$_defmaj" && "$_defmaj" -gt 14 ]]; then _need_override=1; fi
+  fi
+  if [[ -n "$_need_override" ]]; then
+    # Both halves of the same version: $CC has to stay a C compiler, since
+    # Triton feeds it the C launcher it generates for every kernel, and mixing
+    # versions between the two would mix ABIs.
+    _jit_cc=
+    _jit_cxx=
+    for _cand in 11 14 13 12; do
+      if [[ -x "/usr/bin/gcc-${_cand}" && -x "/usr/bin/g++-${_cand}" ]]; then
+        _jit_cc="/usr/bin/gcc-${_cand}"
+        _jit_cxx="/usr/bin/g++-${_cand}"
+        break
+      fi
+    done
+    if [[ -z "$_jit_cxx" ]]; then
+      echo "ERROR: NuRec runtime JIT needs a host gcc <= 14 (nvcc/CUDA 12.8 limit)," >&2
+      echo "       but the default host compiler is unusable and no gcc/g++ pair" >&2
+      echo "       was found. Install one, e.g.: sudo apt-get install gcc-11 g++-11" >&2
+      exit 1
+    fi
+    # gcc < 13 lacks the native _Float16 slang's generated host code uses; alias
+    # it to __fp16. Gated on aarch64 since __fp16 is an Arm-only storage type.
+    if [[ "$(uname -m)" == "aarch64" ]]; then
+      if ! printf 'typedef _Float16 h;\n' | "$_jit_cxx" -x c++ -std=c++17 -fsyntax-only - 2>/dev/null; then
+        _tmp=$(mktemp "${TMPDIR:-/tmp}/nurec-jit-host-cxx.XXXXXX") || {
+          echo "ERROR: failed to create temporary JIT host wrapper" >&2
+          exit 1
+        }
+        chmod 700 "$_tmp"
+        printf '#!/bin/sh\nexec %s -D_Float16=__fp16 "$@"\n' "$_jit_cxx" > "$_tmp"
+        chmod +x "$_tmp"
+        _jit_cxx="$_tmp"
+      fi
+    fi
+    export CC="$_jit_cc"
+    export CXX="$_jit_cxx"
+  fi
+  unset _def_cxx _defmaj _need_override _jit_cc _jit_cxx _tmp _cand
+fi
+
