+	std::string pix_fmt_names;
+	for (const enum AVPixelFormat *fmt = pix_fmts; *fmt != AV_PIX_FMT_NONE; ++fmt) {
+		if (!pix_fmt_names.empty()) pix_fmt_names += "|";
+		pix_fmt_names += av_get_pix_fmt_name(*fmt);
+	}
+	CHECK_GE(av_opt_set(buffersink_ctx_, "pixel_formats", pix_fmt_names.c_str(), AV_OPT_SEARCH_CHILDREN), 0) << "Set output pixel format error.";
