+	// Allocate and initialise the sink in separate steps: ffmpeg rejects option changes
+	// once a filter is initialised, and avfilter_graph_create_filter does both at once.
+	// The option itself was renamed pix_fmts -> pixel_formats and takes format names.
+	buffersink_ctx_ = avfilter_graph_alloc_filter(filter_graph_.get(), buffersink, "out");
