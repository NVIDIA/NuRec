# Base image for `//:run`, `//apps:nurec_tools`, and `//nurec/instant_nurec:run` target images.
#
# This Dockerfile produces a single multi-arch image tag covering both x86_64 and aarch64.
#
# Latest version: run-v16.
#
# When making changes, bump the version number wherever it appears in this file and update
# the `oci.pull` digest/tag for `nurec_run_image_oci` in MODULE.bazel accordingly. Don't
# overwrite existing images unless they've never been referenced in protected branches.
#
# The multi-arch build uses QEMU emulation to cross-build. This is slow. Commands for a
# faster single-arch native build are documented below to allow efficient iteration and local
# testing ahead of generating and pushing the final image.
#
# Prerequisites: install docker utils: https://docs.docker.com/engine/install/ubuntu/
#
# ============================================================================
# One-time host setup for multi-arch builds
# ============================================================================
#
#   # 1. Install QEMU user-mode emulators so the host kernel can run foreign-arch binaries
#   #    during cross-builds.
#   sudo apt install qemu-user-static
#
#   # 2. Create a 'docker-container' driver buildx builder for multi-platform support.
#   docker buildx create --name multiarch --driver docker-container --buildkitd-flags '--oci-worker-gc-keepstorage 10000,20000,100000' --use
#
# ============================================================================
# Optional - Native-only build + load (fast iteration, no QEMU)
# ============================================================================
#
#   docker buildx build --network=host -t nurec/base:run-v16 -f deps/docker/Dockerfile-run.build --load .
#
# ============================================================================
# Final multi-arch build and separate push (slow, load not possible)
# ============================================================================
#
#   docker buildx build --network=host --platform=linux/amd64,linux/arm64 -f deps/docker/Dockerfile-run.build .
#   docker buildx build --network=host --platform=linux/amd64,linux/arm64 -t nurec/base:run-v16 -f deps/docker/Dockerfile-run.build --provenance=false --push .
#
# ============================================================================
# Optional - Delete builder and associated cache volume
# ============================================================================
#
#   docker buildx rm multiarch

# NVIDIA Ubuntu base, sources: https://catalog.ngc.nvidia.com/orgs/nvidia/base/resources/ubuntu-sources/noble-20260911
FROM nvcr.io/nvidia/base/ubuntu:noble-20260911

LABEL maintainer="Janick Martinez Esturo <janickm@nvidia.com>"

# Needed for string substitution
ENV DEBIAN_FRONTEND=noninteractive

RUN \
    # Common base installation
    apt-get update -qq --fix-missing || true && \
    apt-get -y install --no-install-recommends \
        # run dependencies
        python3 python3-pip libgomp1 libglib2.0-0 libgl1 libopenblas-dev \
        # mask annotator dependencies
        libqt6gui6 libqt6widgets6 libqt6core6 libdbus-1-3 libfontconfig1 libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 \
        # asset harvester dependencies
        gcc-11 g++-11 \
        && \
    rm -rf /var/lib/apt/lists/*

RUN \
   # Add python -> python3 symlink (required for bazel-build image entrypoints)
   ln -s /usr/bin/python3 /usr/bin/python && \
   # Remove default ubuntu user to avoid giving its UID/GID a special status when starting the container as non-root user
   userdel -r ubuntu

# Set required driver capabilities ('compute' for cuda, 'graphics' for optix, 'utility' for nvidia-smi)
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility,video

# Make all devices visible by default
ENV NVIDIA_VISIBLE_DEVICES=all

RUN \
    # Upgrade gpgv to at least 2.4.4-2ubuntu17.4 to address security vulnerability CVE-2025-68973,
    # then remove gnupg and its dependencies (keeping gpgv which is required by apt)
    apt-get update -qq && \
    apt-get satisfy -y --no-install-recommends \
      "gpgv (>= 2.4.4-2ubuntu17.4)" \
      "openssl (>= 3.0.13-0ubuntu3.12)" "libssl3t64 (>= 3.0.13-0ubuntu3.12)" && \
    apt-get -y purge --auto-remove gnupg && \
    rm -rf /var/lib/apt/lists/*
