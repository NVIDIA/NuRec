+def _get_dataset_meta(checkpoint_meta, get_num_classes):
+    """Resolve checkpoint metadata using the existing compatibility rules.
+
+    Args:
+        checkpoint_meta: Saved dataset_meta or legacy CLASSES and PALETTE.
+        get_num_classes: Class-count getter used only when metadata is absent.
+
+    Returns:
+        Saved metadata, including an explicit None, or inferred classes and
+        palette when checkpoint metadata is absent.
+    """
+    if 'dataset_meta' in checkpoint_meta:
+        # mmseg 1.x
+        return checkpoint_meta['dataset_meta']
+    if 'CLASSES' in checkpoint_meta:
+        # < mmseg 1.x
+        return {
+            'classes': checkpoint_meta['CLASSES'],
+            'palette': checkpoint_meta['PALETTE'],
+        }
+
+    warnings.simplefilter('once')
+    warnings.warn('dataset_meta or class names are not saved in the '
+                  "checkpoint's meta data, classes and palette will be"
+                  'set according to num_classes ')
+    num_classes = get_num_classes()
+    dataset_name = next(
+        (name for name in dataset_aliases
+         if len(get_classes(name)) == num_classes), None)
+    if dataset_name is None:
+        warnings.warn('No suitable dataset found, use Cityscapes by default')
+        dataset_name = 'cityscapes'
+    return {
+        'classes': get_classes(dataset_name),
+        'palette': get_palette(dataset_name),
+    }
 
 
