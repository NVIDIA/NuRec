@@ -132,1 +137,74 @@ class Mask2formerInferencer(TRTInferencer):
+    def infer_device(
+        self,
+        imgs: torch.Tensor,
+        stream: torch.cuda.Stream,
+    ) -> List[torch.Tensor]:
+        """Enqueue inference with CUDA-resident input and output buffers.
+
+        Args:
+            imgs: Contiguous CUDA tensor with shape
+                ``[max_batch_size, C, H, W]``, dtype and device matching the
+                engine input binding, and BGR channel order.
+            stream: CUDA stream on the engine input device. The caller owns
+                the stream and its synchronization.
+
+        Returns:
+            CUDA tensors that alias the TensorRT output bindings. They remain
+            valid only until the next inference overwrites those bindings, so
+            pipelined callers must copy them to request-owned tensors on
+            ``stream`` before enqueueing another inference.
+
+        Raises:
+            ValueError: If the input device, dtype, shape, or layout does not
+                match the fixed TensorRT binding.
+            RuntimeError: If TensorRT fails to enqueue inference.
+        """
+        engine_input = self.inputs[0]
+        expected_shape = (self.max_batch_size, *self._input_shape)
+        if imgs.device != engine_input.device.device:
+            raise ValueError(
+                f'input device {imgs.device} does not match engine device '
+                f'{engine_input.device.device}')
+        if imgs.dtype != engine_input.device.dtype:
+            raise ValueError(
+                f'input dtype {imgs.dtype} does not match engine dtype '
+                f'{engine_input.device.dtype}')
+        if tuple(imgs.shape) != expected_shape:
+            raise ValueError(
+                f'input shape {tuple(imgs.shape)} does not match engine shape '
+                f'{expected_shape}')
+        if not imgs.is_contiguous():
+            raise ValueError('infer_device expects a contiguous input tensor')
+
+        with torch.cuda.stream(stream):
+            if self.execute_v3:
+                if not self.context.set_tensor_address(
+                        engine_input.name, imgs.data_ptr()):
+                    raise RuntimeError(
+                        'TensorRT failed to bind Mask2Former device input')
+                enqueue_succeeded = self.context.execute_async_v3(
+                    stream_handle=stream.cuda_stream)
+                if not self.context.set_tensor_address(
+                        engine_input.name, engine_input.device_ptr):
+                    raise RuntimeError(
+                        'TensorRT failed to restore Mask2Former input binding')
+            else:
+                bindings = list(self.bindings)
+                try:
+                    input_binding_index = bindings.index(
+                        engine_input.device_ptr)
+                except ValueError as error:
+                    raise RuntimeError(
+                        'TensorRT Mask2Former input binding is missing') from error
+                bindings[input_binding_index] = imgs.data_ptr()
+                enqueue_succeeded = self.context.execute_async(
+                    batch_size=self.max_batch_size,
+                    bindings=bindings,
+                    stream_handle=stream.cuda_stream)
+            if not enqueue_succeeded:
+                raise RuntimeError('TensorRT failed to enqueue Mask2Former inference')
+            imgs.record_stream(stream)
+
+        return [out.device for out in self.outputs]
+
