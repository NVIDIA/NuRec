+def get_model_device_input_spec(
+        model: Union[BaseSegmentor, Mask2formerInferencer],
+        resolution: tuple) -> tuple:
+    """Return the CUDA input shape, dtype, and device for a model.
+
+    Args:
+        model: Initialized PyTorch segmentor or TensorRT inferencer.
+        resolution: Raw input resolution as ``(width, height)``.
+
+    Returns:
+        ``(shape, dtype, device)`` for a contiguous BGR input tensor.
+
+    Raises:
+        TypeError: If ``model`` is not a supported segmentor.
+        RuntimeError: If a PyTorch model has no parameters.
+    """
+    if isinstance(model, Mask2formerInferencer):
+        input_tensor = model.inputs[0].device
+        shape = (model.max_batch_size, *model._input_shape)
+        return tuple(int(value) for value in shape), input_tensor.dtype, input_tensor.device
+    if isinstance(model, BaseSegmentor):
+        try:
+            device = next(model.parameters()).device
+        except StopIteration as error:
+            raise RuntimeError('device inference model has no parameters') from error
+        width, height = (int(value) for value in resolution)
+        return (1, 3, height, width), torch.uint8, device
+    raise TypeError(
+        'device inference expects BaseSegmentor or Mask2formerInferencer, '
+        f'got {type(model)}')
+
+
+def inference_model_device(
+        model: Union[BaseSegmentor, Mask2formerInferencer],
+        img: torch.Tensor,
+        stream: torch.cuda.Stream) -> SegDataSample:
+    """Run segmentation from a CUDA-resident BGR image.
+
+    TensorRT inference binds the supplied image directly. PyTorch inference
+    implements the supported test-pipeline transforms with torch operations.
+
+    Args:
+        model: Initialized PyTorch segmentor or TensorRT inferencer.
+        img: Contiguous CUDA BGR tensor shaped ``[1, 3, H, W]``. TensorRT
+            requires its fixed binding dtype; PyTorch requires ``uint8``
+            values in ``[0, 255]``.
+        stream: CUDA stream owning preprocessing and model inference.
+
+    Returns:
+        A CUDA ``SegDataSample`` containing ``seg_logits.data`` as
+        ``[C, H, W]``, ``pred_sem_seg.data`` as ``[1, H, W]``, and optional
+        backbone features with the configured model shape and dtype.
+        TensorRT fields alias engine bindings and remain valid only until the
+        next inference.
+
+    Raises:
+        TypeError: If ``model`` is not a supported segmentor.
+        ValueError: If input, stream, device, or configured transforms are
+            incompatible with device inference.
+        RuntimeError: If inference returns incomplete outputs.
+    """
+    if img.device.type != 'cuda':
+        raise ValueError(f'device inference expects CUDA input, got {img.device}')
+    if img.ndim != 4 or tuple(img.shape[:2]) != (1, 3):
+        raise ValueError(
+            f'device inference expects [1, 3, H, W] input, got {tuple(img.shape)}')
+    if not img.is_contiguous():
+        raise ValueError('device inference expects contiguous input')
+    if stream.device != img.device:
+        raise ValueError(
+            f'device inference stream is on {stream.device}, input is on {img.device}')
+
+    height, width = (int(value) for value in img.shape[-2:])
+    expected_shape, expected_dtype, expected_device = \
+        get_model_device_input_spec(model, (width, height))
+    if tuple(img.shape) != expected_shape:
+        raise ValueError(
+            f'device inference input shape {tuple(img.shape)} does not match '
+            f'{expected_shape}')
+    if img.dtype != expected_dtype:
+        raise ValueError(
+            f'device inference input dtype {img.dtype} does not match '
+            f'{expected_dtype}')
+    if img.device != expected_device:
+        raise ValueError(
+            f'device inference input is on {img.device}, expected {expected_device}')
+
+    if isinstance(model, Mask2formerInferencer):
+        raw_outputs = model.infer_device(img, stream)
+        if len(raw_outputs) < 2:
+            raise RuntimeError(
+                f'TensorRT returned {len(raw_outputs)} outputs, expected at least 2')
+        prediction = SegDataSample()
+        prediction.seg_logits = PixelData(
+            data=raw_outputs[0].reshape(
+                len(model.dataset_meta['classes']), height, width))
+        prediction.pred_sem_seg = PixelData(
+            data=raw_outputs[1].reshape(1, height, width))
+        if len(raw_outputs) >= 3 and raw_outputs[2].numel():
+            prediction.backbone_feats = PixelData(
+                data=raw_outputs[2].reshape(
+                    tuple(model.cfg.trt_settings.backbone_feats_shape)))
+        return prediction
+
+    supported_transforms = {
+        'LoadAnnotations',
+        'LoadImageFromFile',
+        'LoadImageFromNDArray',
+        'PackSegInputs',
+        'Resize',
+    }
+    unsupported_transforms = [
+        transform.get('type') for transform in model.cfg.test_pipeline
+        if transform.get('type') not in supported_transforms
+    ]
+    if unsupported_transforms:
+        raise ValueError(
+            'CUDA-resident inference does not support test-pipeline transforms '
+            f'{unsupported_transforms}')
+    resize_transforms = [
+        transform for transform in model.cfg.test_pipeline
+        if transform.get('type') == 'Resize'
+    ]
+    if len(resize_transforms) > 1:
+        raise ValueError(
+            'CUDA-resident inference supports at most one Resize transform')
+
+    resized_height, resized_width = height, width
+    if resize_transforms:
+        resize = resize_transforms[0]
+        if 'scale' not in resize:
+            raise ValueError(
+                'CUDA-resident Resize requires an explicit (width, height) scale')
+        target_width, target_height = (int(value) for value in resize['scale'])
+        if resize.get('keep_ratio', False):
+            scale = min(target_width / width, target_height / height)
+            resized_height = int(height * scale + 0.5)
+            resized_width = int(width * scale + 0.5)
+        else:
+            resized_height, resized_width = target_height, target_width
+
+    with torch.no_grad(), torch.cuda.stream(stream):
+        model_input = img.to(dtype=torch.float32)
+        if (resized_height, resized_width) != (height, width):
+            model_input = torch.nn.functional.interpolate(
+                model_input,
+                size=(resized_height, resized_width),
+                mode='bilinear',
+                align_corners=False).round_()
+        data_sample = SegDataSample(
+            metainfo={
+                'ori_shape': (height, width),
+                'img_shape': (resized_height, resized_width),
+                'pad_shape': (resized_height, resized_width),
+                'scale_factor': (resized_width / width,
+                                 resized_height / height),
+                'padding_size': [0, 0, 0, 0],
+                'flip': False,
+            })
+        predictions = model.test_step({
+            'inputs': [model_input[0]],
+            'data_samples': [data_sample],
+        })
+    if len(predictions) != 1:
+        raise RuntimeError(
+            f'device inference returned {len(predictions)} predictions, expected 1')
+    return predictions[0]
+
+
