+def _decode_rgb_frames(video_path: Path) -> Iterator[np.ndarray]:
+    """Yield the video's frames as HWC uint8 RGB arrays, in presentation order.
+
+    Demuxes and decodes packet by packet: SimpleDecoder's frame indexing returns frames out of place on HEVC
+    streams with B-frames.
+    """
+    demuxer = nvc.CreateDemuxer(str(video_path))
+    decoder = nvc.CreateDecoder(
+        gpuid=0,  # the container sees its one GPU as 0
+        codec=demuxer.GetNvCodecId(),
+        usedevicememory=False,
+        outputColorType=nvc.OutputColorType.RGB,  # ty: ignore[unresolved-attribute]
+    )
+    for packet in itertools.chain(demuxer, [nvc.PacketData()]):  # the empty packet flushes the decoder
+        for frame in decoder.Decode(packet):
+            yield np.array(np.from_dlpack(frame))  # copy: the decoder reuses its output surfaces
+
