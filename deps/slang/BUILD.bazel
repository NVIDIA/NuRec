package(default_visibility = ["//:core_package_group"])

# Aliases for slang targets depending on the target platform
alias(
    name = "slangc",
    actual =
        select({
            "@platforms//cpu:aarch64": "@slang_aarch64//:slangc",
            "//conditions:default": "@slang_x86_64//:slangc",
        }),
)

# slangc + its libs, for runtime-JIT runfiles (see slang.BUILD:slangc_runfiles).
alias(
    name = "slangc_runfiles",
    actual =
        select({
            "@platforms//cpu:aarch64": "@slang_aarch64//:slangc_runfiles",
            "//conditions:default": "@slang_x86_64//:slangc_runfiles",
        }),
)

alias(
    name = "slang_headers",
    actual =
        select({
            "@platforms//cpu:aarch64": "@slang_aarch64//:slang_headers",
            "//conditions:default": "@slang_x86_64//:slang_headers",
        }),
)

alias(
    name = "lib_slang_compiler",
    actual =
        select({
            "@platforms//cpu:aarch64": "@slang_aarch64//:lib_slang_compiler",
            "//conditions:default": "@slang_x86_64//:lib_slang_compiler",
        }),
)

alias(
    name = "lib_slang_rtc",
    actual =
        select({
            "@platforms//cpu:aarch64": "@slang_aarch64//:lib_slang_rtc",
