diff --git a/slangtorch/slangtorch.py b/slangtorch/slangtorch.py
index 2234f7d..cb6806a 100644
--- a/slangtorch/slangtorch.py
+++ b/slangtorch/slangtorch.py
@@ -40,6 +40,23 @@ slangcPath = os.path.join(
 if 'SLANGC_PATH' in os.environ:
     _slangcPathOverride = True
     slangcPath = os.environ['SLANGC_PATH']
+else:
+    # Prefer the Bazel-pinned slangc from runfiles (via slang_utils:slangtorch_jit)
+    # so runtime JIT matches the build-time slang; fall back to the bundled one.
+    _arch_tag = 'slang_aarch64' if os.uname().machine != 'x86_64' else 'slang_x86_64'
+    _runfiles_dir = None
+    _p = os.path.abspath(__file__)
+    while _p != os.path.dirname(_p):
+        if _p.endswith('.runfiles'):
+            _runfiles_dir = _p
+            break
+        _p = os.path.dirname(_p)
+    if _runfiles_dir:
+        for _cand in glob.glob(os.path.join(_runfiles_dir, '*' + _arch_tag + '*', 'bin', 'slangc')):
+            if os.path.isfile(_cand) and os.access(_cand, os.X_OK):
+                _slangcPathOverride = True
+                slangcPath = _cand
+                break
 
 # Ensure that slangcPath is a proper path
 slangcPath = os.path.realpath(slangcPath)
