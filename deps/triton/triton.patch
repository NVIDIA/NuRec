 def sm_arch_from_capability(capability: int):
+    # NuRec: TRITON_OVERRIDE_SM_ARCH forces the literal sm_NNN string handed to
+    # nvrtc/ptxas.
+    if (override := os.environ.get("TRITON_OVERRIDE_SM_ARCH")):
