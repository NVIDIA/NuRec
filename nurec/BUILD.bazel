load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib_reporoot",
    srcs = [
        "repo_root.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        # Add visibility for //apps
        "//apps:__pkg__",
    ],
    deps = [
        ":pylib_reporoot",
        "//nurec/config:pylib_version",
        "//nurec/utils:pylib_colored_exceptions",
        "//nurec/utils:pylib_legacy_pickle",
        "//nurec/utils:pylib_misc",
        "//nurec/utils/debug:pylib",
    ],
)

# Tracy default variant (CPU-only)
py_library(
    name = "pylib_tracy",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//:__pkg__",
    ],
    deps = [
        ":pylib_reporoot",
        "//nurec/config:pylib_version",
        "//nurec/utils:pylib_legacy_pickle",
        "//nurec/utils:pylib_misc_tracy",
        "//nurec/utils/debug:pylib",
    ],
)

# Tracy GPU variant
py_library(
    name = "pylib_tracy_gpu",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//:__pkg__",
    ],
    deps = [
        ":pylib_reporoot",
        "//nurec/config:pylib_version",
        "//nurec/utils:pylib_legacy_pickle",
        "//nurec/utils:pylib_misc_tracy_gpu",
        "//nurec/utils/debug:pylib",
    ],
)
