load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = ["//visibility:public"])

# Please see bazel/version/BUILD.bazel for more information on NuRec's version determination system
py_library(
    name = "pylib_version",
    srcs = [
        "version.py",
    ],
    data = ["//bazel/version:workspace_status.sh"],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        # Add visibility for //apps
        "//apps:__pkg__",
    ],
    deps = [
        pip_requirement("pydantic"),
        pip_requirement("pyyaml"),
    ],
)

py_library(
    name = "pylib_trainer_config",
    srcs = ["trainer.py"],
    deps = [
        pip_requirement("pydantic"),
        pip_requirement("torch"),
        ":pylib_base_schema",
    ],
)

py_library(
    name = "pylib_base_schema",
    srcs = ["base_schema.py"],
    deps = [
        pip_requirement("pydantic"),
    ],
)

py_library(
    name = "pylib_scopedtimer",
    srcs = ["scopedtimer.py"],
    deps = [
        ":pylib_base_schema",
    ],
)

# Dependency-light schemas that instant_nurec may import without creating the
# //nurec/config:pylib <-> //nurec/instant_nurec/config:pylib cycle.
py_library(
    name = "pylib_leaf_schemas",
    srcs = [
        "checkpoint.py",
        "ground_mesh.py",
        "harmonizer.py",
        "logger.py",
        "model.py",
        "optim.py",
        "viewer.py",
    ],
    deps = [
        pip_requirement("omegaconf"),
        pip_requirement("pydantic"),
        pip_requirement("shortuuid"),
        ":pylib_base_schema",
    ],
)

py_library(
    name = "pylib_resolvers",
    srcs = ["resolvers.py"],
    deps = [
        "//nurec/ncore_backends:pylib",
        pip_requirement("omegaconf"),
        pip_requirement("universal-pathlib"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "asset_harvest.py",
        "base_schema.py",
        "component_only.py",
        "datamodule.py",
        "dataset.py",
        "fixed_camera_render.py",
        "nurec.py",
        "prober.py",
        "profiling.py",
        "sensor.py",
        "systems.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//:asset_harvester_package_group",
    ],
    deps = [
        "//nurec/libs/losses/orchestration:pylib_config",
        pip_requirement("pydantic"),
        pip_requirement("omegaconf"),
        pip_requirement("nvidia-ncore"),
        ":pylib_base_schema",
        ":pylib_leaf_schemas",
        ":pylib_scopedtimer",
        ":pylib_trainer_config",
        ":pylib_version",
        # NuRecConfig owns the optional canonical InstantNuRecConfig field. Keep instant_nurec's
        # reverse dependencies restricted to the leaf targets above.
        "//nurec/instant_nurec/config:pylib",
        "//nurec/utils:pylib_trainer",
    ],
)

# Keep Hydra composition and in-process-instant_nurec materialization out of schema-only consumers.
py_library(
    name = "pylib_parse",
    srcs = ["parse.py"],
    visibility = DEFAULT_VISIBILITY + [
        "//:asset_harvester_package_group",
    ],
    deps = [
        ":pylib",
        ":pylib_base_schema",
        ":pylib_resolvers",
        "//nurec:pylib_reporoot",
        "//nurec/instant_nurec/config:pylib_parse",
        "//nurec/utils:pylib_misc",
        pip_requirement("hydra-core"),
        pip_requirement("omegaconf"),
    ],
)

