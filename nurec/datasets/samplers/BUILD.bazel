load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

package(default_visibility = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
])

py_library(
    name = "pylib_base",
    srcs = ["base.py"],
    deps = [
        "//nurec/utils:pylib_profiling",
        "//nurec/utils:pylib_types",
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
    ],
)

py_library(
    name = "pylib_image_crop",
    srcs = ["image_crop.py"],
    deps = [
        ":pylib_base",
        "//nurec/config:pylib_image_resolution",
        "//nurec/utils:pylib_profiling",
        "//nurec/utils:pylib_types",
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "fixed.py",
        "holdout.py",
        "lidar_crop.py",
        "semantic.py",
        "timestamp.py",
        "uniform.py",
        "weighted.py",
    ],
    deps = [
        ":pylib_base",
        ":pylib_image_crop",
        "//nurec/harmonizer:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_misc",
        "//nurec/utils:pylib_types",
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
    ],
)

pytest_test(
    name = "image_crop_test",
    srcs = ["image_crop_test.py"],
    deps = [
        ":pylib_image_crop",
        # Required by base.py's TYPE_CHECKING imports for image_crop_test_mypy.
        "//nurec/datasets:pylib",
        "//nurec/utils:pylib_types",
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
        pip_requirement("pydantic"),
    ],
)

pytest_test(
    name = "holdout_test",
    srcs = ["holdout_test.py"],
    deps = [
        "//nurec/datasets:pylib",
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
    ],
)

pytest_test(
    name = "fixed_test",
    srcs = ["fixed_test.py"],
    deps = [
        "//nurec/datasets:pylib",
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
    ],
)

pytest_test(
    name = "uniform_test",
    srcs = ["uniform_test.py"],
    deps = [
        "//nurec/datasets:pylib",
        pip_requirement("numpy"),
        pip_requirement("omegaconf"),
    ],
)
