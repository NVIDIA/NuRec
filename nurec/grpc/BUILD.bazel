# Consumes the production module through :pylib_multiproc (the single compile owner of
# multiproc_serve.py) rather than recompiling it. Deps below are only what multiproc_serve_test.py
# imports directly; production-only transitives (artifact, health, composite, MPS) arrive via the
# library dependency.
pytest_test(
    name = "multiproc_serve_test",
    srcs = [
        "multiproc_serve_test.py",
    ],
    deps = [
        ":pylib",  # nurec.grpc.{model_owner,scene_cache,serve,grpc_server_config}
        ":pylib_multiproc",  # nurec.grpc.multiproc_serve (single compile owner)
        "//nurec/config:pylib",  # from nurec.config.model import RendererBackend
        "//nurec/grpc/protos:grpc_pb2",  # from nurec.grpc.protos import ...
        pip_requirement("click"),  # from click.testing import CliRunner
        pip_requirement("grpcio"),
        pip_requirement("numpy"),
        pip_requirement("pyyaml"),  # multiproc_serve_test.py imports yaml directly
        pip_requirement("torch"),
    ],
)

# Standalone rather than pytest-driven: multiprocessing `spawn` re-imports its main module, while the
# repository's pytest launcher is not guarded as an import-safe multiprocessing main. This target exercises
# the production spawn boundary directly without recursively starting pytest in each child.
py_test(
    name = "worker_lifecycle_spawn_test",
    srcs = ["worker_lifecycle_spawn_test.py"],
    main = "worker_lifecycle_spawn_test.py",
    deps = [
        ":pylib",  # nurec.grpc.model_owner
        ":pylib_multiproc",
    ],
)

mypy_test(
    name = "worker_lifecycle_spawn_test_mypy",
    deps = [
        ":worker_lifecycle_spawn_test",
    ],
)

# Standalone so a parent process can terminate the CUDA child and report a deterministic failure if
# concurrent calls deadlock inside the native extension instead of hanging the Bazel test runner.
py_test(
    name = "nvjpeg_batch_encoder_concurrency_test",
    size = "large",
    timeout = "long",
    srcs = ["nvjpeg_batch_encoder_concurrency_test.py"],
    main = "nvjpeg_batch_encoder_concurrency_test.py",
    tags = ["exclusive"],
    deps = [
        ":pylib",
        pip_requirement("torch"),
    ],
)

mypy_test(
    name = "nvjpeg_batch_encoder_concurrency_test_mypy",
    deps = [
        ":nvjpeg_batch_encoder_concurrency_test",
    ],
)

