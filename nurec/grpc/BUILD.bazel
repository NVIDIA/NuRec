# Thin executable wrapper: multiproc_serve_main.py imports main() from :pylib_multiproc (the single
# compile owner of multiproc_serve.py). All CLI/launch logic and its transitive deps ride along via
# the library, so the binary itself only compiles the wrapper.
py_binary(
    name = "multiproc_serve",
    srcs = ["multiproc_serve_main.py"],
    main = "multiproc_serve_main.py",
    tags = ["manual"],  # Needs a GPU +.usdz artifact; owner + N worker gRPC servers + proxy
    deps = [
        ":pylib_multiproc",
    ],
)

