# Focused SE3 <-> gRPC pose conversion helpers (nurec.grpc.pose). Split out of the monolithic
# `serve.py` so lightweight clients/tooling (the concurrent-render benchmark harness) can import
# the pure pose math without transitively compiling the entire GPU serving stack pulled in by
# `:pylib` (gaussians, render, viewer, pytorch_lightning, ...). `serve.py` re-exports for compat.
py_library(
    name = "pylib_pose",
    srcs = ["pose.py"],
    visibility = DEFAULT_VISIBILITY + [],
    deps = [
        # `nurec.grpc.protos.common_pb2` (grpc_types.Pose/Vec3/Quat).
        "//nurec/grpc/protos:grpc_pb2",
        # `nurec.utils.geometry.tquat_to_se3_matrix` (light: torch/lietorch/scipy/ncore, no GPU serving stack).
        "//nurec/utils:pylib_geometry",
        pip_requirement("numpy"),
        pip_requirement("scipy"),
        pip_requirement("torch"),
    ],
)

# Packages the multi-process drop-in into anything that ships `serve-grpc` (notably `//:run`), so
# `serve-grpc --multiproc-workers N` can lazily `import nurec.grpc.multiproc_serve`. Depends on `:pylib`
# one-directionally (serve.py's import of this module is lazy, which is what breaks the bazel cycle).
py_library(
    name = "pylib_multiproc",
    srcs = ["multiproc_serve.py"],
    visibility = DEFAULT_VISIBILITY + [
        "//:__pkg__",
    ],
    deps = [
        ":pylib",
        # Direct deps for multiproc_serve.py's top-level imports. These resolved only transitively through
        # :pylib before, so they would break silently if :pylib ever stopped re-exporting them.
        "//nurec/artifact:pylib",  # from nurec.artifact.artifact import Artifact
        "//nurec/config:pylib",  # from nurec.config.model import RendererBackend
        "//nurec/grpc/protos:grpc_pb2",  # from nurec.grpc.protos import common_pb2, sensorsim_pb2
        "//nurec/models/gaussians:pylib_gaussians_composite",
        "//nurec/utils:pylib",  # from nurec.utils.metrics import MetricsCollector, create_metric_sample
        "//nurec/utils:pylib_mps_prelaunch",  # mps_active delegates to the stdlib detection helper
        pip_requirement("grpcio"),
        pip_requirement("grpcio-health-checking"),  # from grpc_health.v1 import health, health_pb2, ...
        pip_requirement("pyyaml"),  # multiproc_serve.py imports yaml directly (was only transitive)
        pip_requirement("torch"),
    ],
)

cc_binary(
    name = "nurec_nvjpeg_batch_encoder_cc",
    srcs = ["nvjpeg_batch_encoder.cpp"],
    copts = [
        # Flags to be consistent with torch-cuda-extensions and to build correct torch-extension bindings.
        "-DTORCH_API_INCLUDE_EXTENSION_H",
        "-DTORCH_EXTENSION_NAME=libnurec_nvjpeg_batch_encoder_cc",
    ],
    linkopts = [
        "-Wl,--no-undefined",
        "-Wl,--as-needed",
    ],
    linkshared = True,
    deps = [
        "//deps/torch:torch_headers",
        "@cuda",
        "@cuda//:cuda_headers",
        "@cuda//:cuda_runtime",
        "@cuda//:nvjpeg",
        "@nurec_pip_deps//torch:libc10",
        "@nurec_pip_deps//torch:libc10_cuda",
        "@nurec_pip_deps//torch:libtorch_cpu",
        "@nurec_pip_deps//torch:libtorch_python",
        "@rules_python//python/cc:current_py_cc_headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

