load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nurec/instant_nurec:__subpackages__",
    "//nurec/run:__pkg__",
]

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "datamodule.py",
        "instant_nurec_base.py",
        "instant_nurec_ncore.py",
        "instant_nurec_ncore_websocket.py",
        "registry.py",
        "samplers.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("nvidia-ncore"),
        pip_requirement("pandas"),
        pip_requirement("pytorch_lightning"),
        pip_requirement("universal-pathlib"),
        pip_requirement("s3fs"),
        pip_requirement("torch"),
        pip_requirement("websockets"),
        "//nurec/datasets:pylib",
        "//nurec/datasets:pylib_tracks",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/ncore_backends:pylib",
        "//nurec/utils:pylib_files",
        "//nurec/utils:pylib_misc",
        "//nurec/utils:pylib_ncore_types",
        "//nurec/utils:pylib_ncore_utils",
        "//nurec/utils:pylib_types",
    ],
)

pytest_test(
    name = "datamodule_test",
    srcs = ["datamodule_test.py"],
    deps = [
        ":pylib",
        "//nurec/instant_nurec/config:pylib",
    ],
)

pytest_test(
    name = "instant_nurec_base_test",
    srcs = ["instant_nurec_base_test.py"],
    deps = [
        ":pylib",
        "//nurec/instant_nurec/config:pylib",
    ],
)

pytest_test(
    name = "instant_nurec_ncore_paths_test",
    srcs = ["instant_nurec_ncore_paths_test.py"],
    deps = [
        ":pylib",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/ncore_backends:pylib",
        "//nurec/utils:pylib",
        pip_requirement("numpy"),
        pip_requirement("universal-pathlib"),
    ],
)

pytest_test(
    name = "samplers_test",
    srcs = ["samplers_test.py"],
    deps = [
        ":pylib",
        "@rules_python//python/runfiles",
    ],
