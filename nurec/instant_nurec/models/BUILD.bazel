load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nurec/instant_nurec:__subpackages__",
    # Loss functions might want to peak into the supervision pack
    "//nurec/libs/losses:__subpackages__",
]

filegroup(
    name = "optimized_python_sources",
    srcs = ["kelvin_model.py"],
    visibility = ["//nurec/instant_nurec:__pkg__"],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "activations.py",
        "base.py",
        "celsius_model.py",
        "checkpoint.py",
        "kelvin_model.py",
        "legacy_tokengs_to_kelvin_ckpt.py",
        "post_processing.py",
        "tokenizer.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("numpy"),
        pip_requirement("einops"),
        pip_requirement("safetensors"),
        "//nurec/config:pylib_version",
        "//nurec/datasets:pylib_tracks",
        "//nurec/instant_nurec:pylib_supervision_pack",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/instant_nurec/models/blocks:pylib",
        "//nurec/instant_nurec/models/kelvin_backbone:pylib",
        "//nurec/instant_nurec/primitives:pylib",
        "//nurec/instant_nurec/utils:pylib",
        "//nurec/models:pylib_nn_extensions",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_files",
        "//nurec/utils:pylib_misc",
        "//nurec/utils:pylib_profiling",
        "//nurec/utils:pylib_types",
        "@cosmos_predict1",
    ],
)

pytest_test(
    name = "base_model_test",
    timeout = "long",
    srcs = ["base_model_test.py"],
    deps = [
        ":pylib",
    ],
)

pytest_test(
    name = "tokenizer_test",
    srcs = ["tokenizer_test.py"],
    deps = [
        ":pylib",
    ],
)

py_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["base_model_test.py"],
    visibility = [],
    deps = [
        ":pylib",
        pip_requirement("pytest"),
    ],
)
