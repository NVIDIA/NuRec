load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    # Broader visibility so renderer could take this
    "//:core_package_group",
]

filegroup(
    name = "optimized_python_sources",
    srcs = ["kelvin_primitive.py"],
    visibility = ["//nurec/instant_nurec:__pkg__"],
)

py_library(
    name = "pylib",
    srcs = [
        "base.py",
        "celsius_primitive.py",
        "kelvin_primitive.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
        "//nurec/config:pylib_version",
        "//nurec/instant_nurec:pylib_supervision_pack",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/instant_nurec/utils:pylib_covariance",
        "//nurec/instant_nurec/utils:pylib_cubemap",
        "//nurec/models:pylib",
        "//nurec/models:pylib_background_sampling",
        "//nurec/models/gaussians:pylib",
        "//nurec/utils:pylib_geometry",
        "//nurec/utils:pylib_misc",
        "//nurec/utils:pylib_types",
    ],
)

pytest_test(
    name = "base_test",
    srcs = ["base_test.py"],
    deps = [
        ":pylib",
        pip_requirement("torch"),
    ],
)

pytest_test(
    name = "kelvin_primitive_test",
    srcs = ["kelvin_primitive_test.py"],
    deps = [
        ":pylib",
        "//nurec/utils:pylib_types",
        pip_requirement("torch"),
    ],
)
