load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nurec/instant_nurec:__subpackages__",
]

filegroup(
    name = "optimized_python_sources",
    srcs = ["base.py"],
    visibility = ["//nurec/instant_nurec:__pkg__"],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "base.py",
        "gaussians_instant_nurec.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nurec/compression:pylib_usdz",
        "//nurec/config:pylib",
        "//nurec/datasets:pylib_tracks",
        "//nurec/instant_nurec:pylib_supervision_pack",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/instant_nurec/datasets:pylib",
        "//nurec/instant_nurec/models:pylib",
        "//nurec/instant_nurec/predict:pylib",
        "//nurec/instant_nurec/primitives:pylib",
        "//nurec/instant_nurec/utils:pylib_trajectory",
        "//nurec/libs/losses:pylib",
        "//nurec/render:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_geometry",
        "//nurec/utils:pylib_misc",
        "//nurec/utils:pylib_types",
        pip_requirement("torch"),
        pip_requirement("pytorch-lightning"),
        pip_requirement("numpy"),
        pip_requirement("einops"),
        pip_requirement("nvidia-ncore"),
    ],
)

pytest_test(
    name = "gaussians_instant_nurec_test",
    srcs = ["gaussians_instant_nurec_test.py"],
    deps = [
        ":pylib",
        pip_requirement("torch"),
    ],
)
