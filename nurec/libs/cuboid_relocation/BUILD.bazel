load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//:core_package_group"])

cuda_library(
    name = "sampling_cuda",
    srcs = ["sampling.cu"],
    hdrs = ["cuboid_relocation.h"],
    # Preserve small opacity weights and double CDF arithmetic; no fast math.
    deps = [
        "//deps/torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cuda_library(
    name = "correction_cuda",
    srcs = ["correction.cu"],
    hdrs = ["cuboid_relocation.h"],
    # Match gsplat correction arithmetic without flushing tiny sampling weights.
    copts = ["--use_fast_math"],
    deps = [
        "//deps/torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cuda_library(
    name = "perturbation_cuda",
    srcs = ["perturbation.cu"],
    hdrs = ["cuboid_relocation.h"],
    # Match the separate multiplication/reduction in the native rejection rule.
    copts = ["--fmad=false"],
    deps = [
        "//deps/torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_binary(
    name = "cuboid_relocation_cuda_cc",
    srcs = ["binding.cpp"],
    copts = [
        "-DTORCH_API_INCLUDE_EXTENSION_H",
        "-DTORCH_EXTENSION_NAME=libcuboid_relocation_cuda_cc",
    ],
    linkopts = [
        "-Wl,--no-undefined",
        "-Wl,--as-needed",
    ],
    linkshared = True,
    deps = [
        ":correction_cuda",
        ":perturbation_cuda",
        ":sampling_cuda",
        "//deps/torch:torch_headers",
        "@nurec_pip_deps//torch:libc10",
        "@nurec_pip_deps//torch:libc10_cuda",
        "@nurec_pip_deps//torch:libtorch_cpu",
        "@nurec_pip_deps//torch:libtorch_python",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

py_library(
    name = "pylib_cc",
    srcs = ["__init__.py"],
    data = [":cuboid_relocation_cuda_cc"],
    deps = [pip_requirement("torch")],
)
