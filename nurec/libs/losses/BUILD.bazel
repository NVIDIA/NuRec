load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//bazel/docs:__pkg__",
    ],
    deps = [
        "//nurec/libs/losses/functional:pylib",
        "//nurec/libs/losses/models:pylib",
        "//nurec/libs/losses/orchestration:pylib",
    ],
)
