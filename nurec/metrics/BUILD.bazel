load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

# Separate library for metric.py to avoid circular dependency
py_library(
    name = "pylib_metric",
    srcs = [
        "metric.py",
        "types.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("pyyaml"),
        "//nurec/config:pylib",
        "//nurec/datasets:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_types",
    ],
)

# Separate library for utils.py to avoid circular dependency
py_library(
    name = "pylib_utils",
    srcs = [
        "utils.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [],
    deps = [
        "//nurec/metrics/impl:pylib",
    ],
)

py_library(
    name = "pylib_compute",
    srcs = [
        "compute_metrics.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
    deps = [
        "//nurec/metrics:pylib_metric",
        "//nurec/metrics/impl:pylib",
    ],
)

pytest_test(
    name = "metric_test",
    size = "medium",
    srcs = [
        "metric_test.py",
    ],
    deps = [
        ":pylib",
    ],
)

pytest_test(
    name = "utils_test",
    size = "medium",
    srcs = [
        "utils_test.py",
    ],
    deps = [
        ":pylib",
    ],
)
