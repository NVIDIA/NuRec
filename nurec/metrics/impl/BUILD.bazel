load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib",
    srcs = [
        "cpsnr.py",
        "drift.py",
        "factory.py",
        "fcs_adaptive.py",
        "fid.py",
        "higher_order_moments.py",
        "lidar_common.py",
        "lpips.py",
        "ntd.py",
        "object_level_perceptual.py",
        "object_level_semantic.py",
        "perceptual.py",
        "psnr.py",
        "road_quality.py",
        "ssim.py",
        "temporal_coherence.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//nurec/benchmark:__subpackages__",
    ],
    deps = [
        pip_requirement("torchmetrics"),
        pip_requirement("torch"),
        pip_requirement("point_cloud_utils"),
        pip_requirement("numpy"),
        pip_requirement("scipy"),
        pip_requirement("scikit-learn"),
        pip_requirement("transformers"),
        pip_requirement("pillow"),
        "//nurec/datasets:pylib",
        "//nurec/metrics:pylib_metric",
        "//nurec/metrics:pylib_utils",
        "//nurec/metrics/impl/utils:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_types",
    ],
)

