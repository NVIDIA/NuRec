load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib",
    srcs = [
        "feature_extractor.py",
        "perceptual_utils.py",
        "road_utils.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//nurec/benchmark:__subpackages__",
    ],
    deps = [
        pip_requirement("numpy"),
        pip_requirement("opencv-python"),
        pip_requirement("pillow"),
        pip_requirement("scikit-image"),
        pip_requirement("scipy"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("transformers"),
        "//nurec/utils:pylib",
    ],
)

pytest_test(
    name = "feature_extractor_test",
    size = "medium",
    srcs = [
        "feature_extractor_test.py",
    ],
    deps = [
        ":pylib",
        "//nurec/metrics:pylib_utils",
    ],
)

pytest_test(
    name = "perceptual_utils_test",
    size = "small",
    srcs = [
        "perceptual_utils_test.py",
    ],
    deps = [
        ":pylib",
    ],
)

pytest_test(
    name = "road_utils_test",
    size = "medium",
    srcs = [
        "road_utils_test.py",
    ],
    deps = [
        ":pylib",
    ],
)
