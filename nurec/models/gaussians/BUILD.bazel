load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

package(default_visibility = [
    "//:core_package_group",
])

# gsplat's //:pylib_lidar is //:pylib plus scipy for the optional LiDAR helpers;
# it carries all of gsplat's runtime deps, so consumers just depend on it.
py_library(
    name = "pylib_cc_gsplat",
    visibility = [
        "//bazel/typing:__pkg__",
        "//nurec/datasets:__pkg__",
        "//nurec/libs/losses/functional:__pkg__",
        "//nurec/libs/losses/models:__pkg__",
        "//nurec/models:__pkg__",
        "//nurec/models/gaussians:__pkg__",
        "//nurec/models/gaussians/strategies:__pkg__",
        "//nurec/utils:__pkg__",
    ],
    deps = [
        "//nurec/utils:pylib_ncore_types",
        "@gsplat//:pylib_lidar",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "construction_barriers.py",
        "construction_barriers_model.py",
        "gaussians_model.py",
        "initializations.py",
        "interpolated_table_gaussians.py",
        "renderers.py",
        "segment_plan.py",
        "temporal_deformation_storage.py",
        "utils.py",
        "vehicle_light.py",
    ],
    visibility = [
        "//:core_package_group",
    ],
    deps = [
        "//apps/av/road_mesh:pylib",
        pip_requirement("nvidia-ncore"),
        pip_requirement("numpy"),
        pip_requirement("torch"),
        pip_requirement("tqdm"),
        pip_requirement("lietorch"),
        pip_requirement("point-cloud-utils"),
        ":pylib_cc_gsplat",
        "//nurec/datasets:pylib",
        "//nurec/libs/geometry/kernels:pylib",
        "//nurec/libs/packed_ops:pylib_cc",
        "//nurec/models:pylib",
        "//nurec/models/base:pylib",
        "//nurec/models/gaussians/collect:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_cached_device_tensor",
        "//nurec/utils:pylib_lidar_object_init_points",
        "//nurec/utils:pylib_morton",
        "//nurec/utils:pylib_optim",
        "//nurec/utils:pylib_renamed_keys",
        "//nurec/utils:pylib_tile_mask",
        "//nurec/utils:pylib_types",
        "//nurec/utils/io:pylib",
        "//nurec/visualdebugger:pylib",
    ],
)

# Torch-only contract for the collected-parameter override hook. Kept as its own tiny
# target so an implementation (//nurec/asset_edits) can depend on the model layer's
# protocol without the model layer depending on the implementation.
py_library(
    name = "pylib_edit_hook",
    srcs = ["edit_hook.py"],
    deps = [
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib_fused_parameter_gather",
    srcs = ["fused_parameter_gather.py"],
    deps = [
        "//nurec/libs/gaussian_collective_payload_ops:pylib_cc",
        "//nurec/utils:pylib_profiling",
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib_gaussians_composite",
    srcs = [
        "context_composite.py",
        "gaussians_composite.py",
    ],
    deps = [
        ":pylib",
        ":pylib_edit_hook",
        ":pylib_fused_parameter_gather",
        "//nurec/models/gaussians/strategies:pylib",
        "//nurec/utils:pylib_component_only_mask",
        "//nurec/utils:pylib_selective_adam_visibility",
        pip_requirement("torch"),
    ],
)

