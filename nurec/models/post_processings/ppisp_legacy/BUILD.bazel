load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = [
    "//:core_package_group",
])

# Slang submodule library
py_library(
    name = "pylib_slang",
    deps = [
        "//nurec/models/post_processings/ppisp_legacy/slang:pylib",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "ppisp_legacy.py",
    ],
    deps = [
        ":pylib_slang",
        "//nurec/models/post_processings:def_constants",
        pip_requirement("ppisp"),
        pip_requirement("torch"),
    ],
)
