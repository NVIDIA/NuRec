pytest_test(
    name = "render_test",
    size = "small",
    srcs = [
        "render_test.py",
    ],
    deps = [
        ":pylib",
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
    ],
)

pytest_test(
    name = "track_labels_test",
    size = "medium",
    srcs = [
        "track_labels_test.py",
    ],
    deps = [
        ":pylib",
        "//nurec/datasets:pylib",
        "//nurec/utils:pylib",
