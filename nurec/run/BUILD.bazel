load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "in_process_instant_nurec.py",
        "main.py",
        "profile_dataloader.py",
        "run_script.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        "//test_data:__pkg__",
    ],
    deps = [
        "//apps/viewer:pylib",
        "//nurec:pylib_reporoot",
        "//nurec/config:pylib",
        "//nurec/config:pylib_parse",
        "//nurec/config:pylib_version",
        "//nurec/datasets:pylib",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/instant_nurec/datasets:pylib",
        "//nurec/instant_nurec/predict:pylib",
        "//nurec/models/gaussians:pylib",
        "//nurec/systems:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_callbacks",
        "//nurec/utils:pylib_prober",
        "//nurec/utils/debug:pylib",
        pip_requirement("click"),
        pip_requirement("pytorch_lightning"),
        pip_requirement("hydra-core"),
        pip_requirement("omegaconf"),
        pip_requirement("numpy"),
        pip_requirement("torch"),
    ],
)

pytest_test(
    name = "run_script_test",
    srcs = [
        "run_script_test.py",
    ],
    data = ["//nurec/libs/losses/examples"],
    deps = [
        ":pylib",
        "//nurec:pylib",
        pip_requirement("click"),
        "@rules_python//python/runfiles",
    ],
)
