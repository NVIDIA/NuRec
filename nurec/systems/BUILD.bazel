    visibility = DEFAULT_VISIBILITY + [],
    deps = [
        "//apps/av/road_mesh:pylib",
        "//nurec/artifact:pylib",
        "//nurec/compression:pylib_usdz",
        "//nurec/config:pylib",
        "//nurec/datamodules:pylib",
        "//nurec/datasets:pylib",
        "//nurec/harmonizer:pylib",
        "//nurec/instant_nurec/config:pylib",
        "//nurec/libs/losses:pylib",
        "//nurec/libs/losses/orchestration:pylib_component_only_normalization",
        "//nurec/metrics:pylib",
        "//nurec/models:pylib",
        "//nurec/models/base:pylib",
        "//nurec/models/gaussians:pylib",
        "//nurec/models/gaussians:pylib_gaussians_composite",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_component_only_mask",
        "//nurec/utils:pylib_component_only_supervision",
        "//nurec/utils:pylib_custom_metrics",
        "//nurec/utils:pylib_optim",
        "//nurec/utils:pylib_selective_adam_visibility",
        "//nurec/utils:pylib_training_rng",
        "//nurec/utils:pylib_types",
        "//nurec/utils/io:pylib",
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
        pip_requirement("pytorch-lightning"),
        pip_requirement("imageio"),
        pip_requirement("numpy"),
        pip_requirement("einops"),
        pip_requirement("imageio-ffmpeg"),
        pip_requirement("setuptools"),
        pip_requirement("torchmetrics"),
        pip_requirement("trimesh"),
        pip_requirement("tqdm"),
    ],
)

py_library(
    name = "utils",
    srcs = ["utils.py"],
    deps = [
        # List any dependencies of utils.py here
        "//nurec/datamodules:pylib",
        "//nurec/libs/losses:pylib",
