load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib_render",
    srcs = [
        "render.py",
        "render_helpers.py",
        "render_lidar.py",
        "render_lidar_ply.py",
        "render_nsight.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        "//nurec/benchmark:__subpackages__",
    ],
    deps = [
        "//nurec/artifact:pylib",
        "//nurec/asset_edits:pylib",  # asset-edit override runtime hooked into render CLI
        "//nurec/datasets:pylib",
        "//nurec/models/gaussians:pylib_gaussians_composite",
        "//nurec/render:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_cli",
        "//nurec/utils:pylib_cudaeventtimer",
        "//nurec/utils:pylib_geometry",
        "//nurec/utils:pylib_metrics",
        "//nurec/utils:pylib_types",
        pip_requirement("click"),
        pip_requirement("imageio"),
        pip_requirement("imageio-ffmpeg"),
        pip_requirement("setuptools"),
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("pillow"),
        pip_requirement("point-cloud-utils"),
        pip_requirement("nvidia-ncore"),
    ],
)

# Light-weight target carved out so PPISP sub-packages (e.g.
# //nurec/utils/io/export/ppisp_export/sh_match:pylib) can depend on the
# SHCoefficientsBearer protocol + scale_sh_coefficients helper
# without pulling the full parent :pylib (which itself depends on
# the PPISP sub-packages, hence the cycle break).
py_library(
    name = "pylib_radiance_scaling",
    srcs = [
        "gaussian_radiance_scaling.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nurec/models/gaussians:pylib",
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib_external_assets",
    srcs = ["external_assets.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nurec/artifact:pylib",
        pip_requirement("click"),
        pip_requirement("pyyaml"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
