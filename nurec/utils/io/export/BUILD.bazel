    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        "//nurec/benchmark:__subpackages__",
    ],
    deps = [
        # PPISP SPG sidecars (Path(__file__).parent lookup inside
        # ppisp_export/usd_writer.py) are pulled in transitively
        # through //nurec/utils/io/export/ppisp_export:pylib's own
        # ``data = [...]`` declaration; no need to re-list them
        # here.
        ":pylib_external_assets",
        ":pylib_radiance_scaling",
        ":pylib_render",
        "//apps/av/road_mesh:pylib",
        "//nurec/artifact:pylib",
        "//nurec/compression:pylib_usdz",
        "//nurec/config:pylib",
        "//nurec/config:pylib_parse",
        "//nurec/datamodules:pylib",
        "//nurec/datasets:pylib",
        "//nurec/ncore_backends:pylib",
        "//nurec/grpc:pylib",
        "//nurec/grpc/protos:grpc_pb2",
        "//nurec/models:pylib",  # for EnvMapType / SkyEnvMapBackground / get_ppisp_from_model in gaussian_usd_asset.py
        "//nurec/models:pylib_background_sampling",
        "//nurec/models/gaussians:pylib",  # for GaussianExportFormat in gaussians_plys.py
        "//nurec/models/gaussians:pylib_gaussians_composite",  # for GaussiansComposite in render_grpc.py
        "//nurec/render:pylib",
        "//nurec/systems:pylib",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_cli",
        "//nurec/utils:pylib_geometry",
        "//nurec/utils:pylib_misc",
        "//nurec/utils:pylib_ncore_utils",
        "//nurec/utils:pylib_types",
        "//nurec/utils/debug:pylib",
        "//nurec/utils/io:pylib",
        "//nurec/utils/io/export/ppisp_export:pylib",
        "//nurec/utils/io/export/ppisp_export/controller:pylib",
        "//nurec/utils/io/export/ppisp_export/sh_match:pylib",
        "//nurec/utils/upgrade:pylib",
        pip_requirement("aiofiles"),
        pip_requirement("click"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("lietorch"),
        pip_requirement("numpy"),
        pip_requirement("tqdm"),
        pip_requirement("pyyaml"),
        pip_requirement("pillow"),
        pip_requirement("imageio"),
        pip_requirement("imageio-ffmpeg"),
        pip_requirement("opencv-python"),
        pip_requirement("point-cloud-utils"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("omegaconf"),
        pip_requirement("ppisp"),
        pip_requirement("scipy"),
        pip_requirement("usd-core"),
        pip_requirement("universal-pathlib"),
    ],
)

