load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib_ncore_sensors_converters",
    srcs = ["ncore_sensors_converters.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nurec/libs/sensors:camera_kernels",
        "//nurec/libs/sensors:lidar_kernels",
        pip_requirement("nvidia-ncore"),
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "sensors.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
        pip_requirement("nvidia-ncore"),
        "//nurec/libs/sensors:pose_calib_kernels",
        "//nurec/utils:pylib_geometry",
        "//nurec/utils:pylib_torch_compile",
    ],
)

pytest_test(
    name = "sensors_test",
    srcs = ["sensors_test.py"],
    data = [
        "//nurec/libs/vren:test_data/row-offset-spinning-lidar-model-parameters.json",
        "@test_data_prober_generated//:sensor_to_world_rays_shutter_pose",
    ],
    deps = [
        pip_requirement("nvidia-ncore"),
        pip_requirement("torch"),
        ":pylib",
        ":pylib_ncore_sensors_converters",
        "//nurec:pylib",
        "//nurec/libs/geometry/kernels:pylib",
        "//nurec/libs/sensors:pylib_slang",
        "//nurec/utils:pylib",
        "//nurec/utils:pylib_prober",
    ],
)
