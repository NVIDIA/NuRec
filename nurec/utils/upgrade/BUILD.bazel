load("@nurec_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "config.py",
        "config_manip.py",
        "model.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nurec/config:pylib_version",
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
    ],
)

pytest_test(
    name = "config_manip_test",
    size = "medium",
    srcs = [
        "config_manip_test.py",
    ],
    deps = [
        ":pylib",
        pip_requirement("omegaconf"),
    ],
)

pytest_test(
    name = "config_test",
    size = "medium",
    srcs = ["config_test.py"],
    deps = [
        ":pylib",
        "//nurec/config:pylib_version",
        pip_requirement("omegaconf"),
    ],
)

pytest_test(
    name = "model_test",
    size = "medium",
    srcs = [
        "model_test.py",
    ],
    deps = [
        ":pylib",
        "//nurec/config:pylib_version",
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
    ],
)
