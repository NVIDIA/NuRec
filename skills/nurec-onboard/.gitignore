# Tracked even though the enclosing repository ignores `.claude/` and `*.lock`:
# the launcher generates its Claude Code settings from the template in
# `.claude/`, and converter workdirs reuse the template's lock to skip module
# resolution.
!.claude/
!MODULE.bazel.lock

# Claude Code transient files; run.sh generates settings.local.json from
# settings.local.template.json on each launch.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/.claude.json

# Bazel cache override generated by run.sh
.bazelrc.user.nurec-onboard-cache
