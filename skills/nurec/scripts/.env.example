# Source these values in your host Bash shell after choosing the release.
# No secrets belong in this file. HF_TOKEN is optional for gated assets and must
# be supplied through the environment without printing it.
export NUREC_SRC=/absolute/path/to/NuRec
export NUREC_DEV_DEPS_IMAGE=ghcr.io/nvidia/nurec/nurec_dev_deps:26.10
# Build this image using references/install.md before running nurec_dev.
export NUREC_IMAGE=nurec_dev:local
export NUREC_OUTPUT_BASE="$HOME/.cache/nurec-bazel"
